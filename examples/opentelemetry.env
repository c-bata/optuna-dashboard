# OpenTelemetry Configuration for Optuna Dashboard
# This file contains example environment variables for configuring OpenTelemetry

# Enable/Disable OpenTelemetry SDK
# OTEL_SDK_DISABLED=false

# Service information
# OTEL_SERVICE_NAME=optuna-dashboard
# OTEL_SERVICE_VERSION=1.0.0
# OTEL_SERVICE_NAMESPACE=optuna

# Trace configuration
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=grpc
# OTEL_TRACES_SAMPLER=traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0

# Metrics configuration
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=grpc
# OTEL_METRIC_EXPORT_INTERVAL=30000

# Prometheus metrics endpoint (if you want to expose metrics via Prometheus)
# OTEL_EXPORTER_PROMETHEUS_PORT=9090

# Resource attributes
# OTEL_RESOURCE_ATTRIBUTES=service.name=optuna-dashboard,service.version=1.0.0,deployment.environment=production

# Instrumentation configuration
# OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true

# Example: Full configuration for development with Jaeger and Prometheus
# export OTEL_SERVICE_NAME=optuna-dashboard
# export OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:14250
# export OTEL_EXPORTER_PROMETHEUS_PORT=9090
# export OTEL_TRACES_SAMPLER=traceidratio
# export OTEL_TRACES_SAMPLER_ARG=1.0

# Example: Configuration for production with OTLP collector
# export OTEL_SERVICE_NAME=optuna-dashboard
# export OTEL_EXPORTER_OTLP_ENDPOINT=https://your-collector:4317
# export OTEL_EXPORTER_OTLP_HEADERS="x-api-key=your-api-key"
# export OTEL_TRACES_SAMPLER=traceidratio
# export OTEL_TRACES_SAMPLER_ARG=0.1
