{
  "name": "@optuna/storage",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "description": "Loaders for Optuna storages",
  "main": "pkg/index.js",
  "exports": {
    ".": {
      "types": "./pkg/index.d.ts",
      "import": "./pkg/index.js"
    },
    "./worker-client": {
      "types": "./pkg/worker_client.d.ts",
      "import": "./pkg/worker_client.js"
    },
    "./rustuna-wasm": {
      "types": "./pkg/rustuna_wasm.d.ts",
      "import": "./pkg/rustuna_wasm.js"
    }
  },
  "scripts": {
    "build": "tsc -d",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optuna/optuna-dashboard.git"
  },
  "keywords": [
    "optuna"
  ],
  "author": "Optuna Development Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/optuna/optuna-dashboard/issues"
  },
  "homepage": "https://github.com/optuna/optuna-dashboard#readme",
  "dependencies": {
    "rustuna": "link:../../rustuna/rustuna_js"
  },
  "devDependencies": {
    "@optuna/types": "workspace:*",
    "typescript": "catalog:"
  }
}
